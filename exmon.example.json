{
  "log": {
    "path": "%ProgramData%\\exmon\\exmon.log",
    "maxSizeMB": 50,
    "maxFiles": 5,
    "flushIntervalMs": 1000
  },
  "wifi": {
    "enabled": true,
    "pollSeconds": 5,
    "neighbors": false,
    "debugPoll": false,
    "rssiThreshold": 3,
    "rateChangePercent": 50,
    "errorPctThreshold": 10,
    "minStatsFrames": 500,
    "heartbeatSeconds": 15,
    "disconnectWindowMinutes": 30
  },
  "nic": {
    "enabled": true,
    "pollSeconds": 15,
    "heartbeatSeconds": 60,
    "includeVirtual": false
  },
  "vpn": {
    "enabled": true,
    "pollSeconds": 30,
    "heartbeatSeconds": 60,
    "pingCount": 3,
    "adapterPatterns": [
      "Cisco AnyConnect", "GlobalProtect", "PANGP", "Palo Alto", "Zscaler", "Fortinet",
      "FortiClient", "WireGuard", "OpenVPN", "TAP-Windows", "SonicWall", "Pulse Secure",
      "Juniper", "Check Point", "Tailscale"
    ],
    "processNames": ["vpnui", "vpnagent", "PanGPA", "PanGPS", "ZSATunnel", "FortiClient", "dsNcService", "vpnc", "tailscaled"]
  },
  "services": {
    "enabled": true,
    "pollSeconds": 30,
    "heartbeatMinutes": 60,
    "watch": [
      { "name": "Dnscache" },
      { "name": "MpsSvc" },
      { "name": "wuauserv", "expect": "any" }
    ]
  },
  "probe": {
    "enabled": true,
    "intervalSeconds": 300,
    "timeoutSeconds": 10,
    "pingCount": 4,
    "dnsNames": ["management.azure.com"],
    "endpoints": [
      { "name": "AzureFrontDoor", "target": "your-app.azurefd.net",              "port": 443 },
      { "name": "SQLServer",      "target": "your-sql.database.windows.net",     "port": 1433 },
      { "name": "StorageAccount", "target": "yourstorage.blob.core.windows.net", "port": 443 },
      { "name": "M365Portal",     "target": "portal.office.com",                 "port": 443 }
    ],
    "httpTests": [
      { "name": "ERP",         "url": "https://your-erp.azurewebsites.net/health" },
      { "name": "M365",        "url": "https://outlook.office365.com" },
      { "name": "SharePoint",  "url": "https://yourtenant.sharepoint.com" },
      { "name": "InternalApp", "url": "https://your-app.azurefd.net" }
    ],
    "pathTrace": { "intervalMinutes": 30, "onIncident": true, "maxHops": 30 }
  },
  "incident": {
    "enabled": true,
    "dir": "%ProgramData%\\exmon\\incidents",
    "windowMinutes": 10,
    "postTriggerSeconds": 30,
    "cooldownSeconds": 300,
    "maxIncidents": 100,
    "maxIncidentsBySeverity": { "1": 500, "2": 300, "3": 100, "4": 50, "5": 20 },
    "maxHoldSeconds": 120,
    "triggers": [
      { "name": "weak-signal",      "source": "wifi",  "metric": "rssi_dbm",           "op": "<",  "threshold": -75,  "forSamples": 3, "severity": 3 },
      { "name": "very-weak-signal", "source": "wifi",  "metric": "rssi_dbm",           "op": "<",  "threshold": -82,  "forSamples": 3, "severity": 1 },
      { "name": "high-retries",     "source": "wifi",  "metric": "retry_pct",          "op": ">",  "threshold": 40,   "forSamples": 2, "severity": 4 },
      { "name": "handshake",        "source": "wifi",  "metric": "handshake_fail",     "op": ">",  "threshold": 0,                     "severity": 2 },
      { "name": "flapping",         "source": "wifi",  "metric": "recent_disconnects", "op": ">=", "threshold": 3,                     "severity": 2 },
      { "name": "gateway-loss",     "source": "probe", "metric": "gateway_loss_pct",   "op": ">=", "threshold": 50,                    "severity": 1 },
      { "name": "endpoint-down",    "source": "probe", "metric": "reachable",          "op": "<",  "threshold": 1,                     "severity": 2 },
      { "name": "slow-http",        "source": "probe", "metric": "http_ttfb_ms",       "op": ">",  "threshold": 3000, "forSamples": 2, "severity": 4 },
      { "name": "nic-errors",       "source": "nic",   "metric": "in_errors",          "op": ">",  "threshold": 100,                   "severity": 3 },
      { "name": "vpn-dropped",      "source": "vpn",   "metric": "vpn_up",             "op": "<",  "threshold": 1,                     "severity": 2 },
      { "name": "service-down",     "source": "services", "metric": "as_expected",    "op": "<",  "threshold": 1,    "forSamples": 2, "severity": 2 }
    ]
  },
  "remotes": [
    {
      "name": "outbox",
      "type": "outbox",
      "enabled": true,
      "settings": { "path": "%ProgramData%\\exmon\\remote-outbox.jsonl" },
      "spoolDir": "%ProgramData%\\exmon\\remote-spool\\outbox",
      "segmentKB": 1024,
      "maxSpoolMB": 100,
      "batchSize": 50,
      "flushIntervalMs": 5000,
      "retryInitialSeconds": 5,
      "retryMaxMinutes": 15,
      "include": [
        { "source": "wifi", "kinds": ["ACM/connection_complete", "ACM/connection_attempt_fail", "ACM/disconnected", "ACM/scan_fail", "MSM/connected", "MSM/disconnected", "MSM/roaming_start", "MSM/roaming_end", "MSM/radio_state_change"] },
        { "kinds": ["INCIDENT/*"], "severityAtLeast": 3 },
        { "kinds": ["PROBE/down", "PROBE/up", "NIC/up", "NIC/down", "VPN/connected", "VPN/disconnected", "VPN/changed", "POWER/not_ready"] },
        { "source": "services", "kinds": ["SERVICE/down", "SERVICE/up", "SERVICE/version_changed"] }
      ]
    },
    {
      "name": "law",
      "type": "azureMonitor",
      "enabled": false,
      "settings": {
        "endpoint": "https://exmon-prod-dcr-xxxx.eastus-1.ingest.monitor.azure.com",
        "dcrImmutableId": "dcr-00000000000000000000000000000000",
        "streamName": "Custom-ExmonEvents",
        "tenantId": "00000000-0000-0000-0000-000000000000",
        "clientId": "00000000-0000-0000-0000-000000000000",
        "clientSecret": "REPLACE-WITH-THE-INGEST-APP-SECRET"
      },
      "batchSize": 200,
      "include": [
        { "source": "wifi", "kinds": ["ACM/connection_complete", "ACM/connection_attempt_fail", "ACM/disconnected", "MSM/disconnected", "MSM/roaming_end"] },
        { "kinds": ["INCIDENT/*"] },
        { "kinds": ["PROBE/down", "PROBE/up", "NIC/up", "NIC/down", "VPN/connected", "VPN/disconnected", "VPN/changed", "POWER/not_ready"] },
        { "source": "services", "kinds": ["SERVICE/status", "SERVICE/down", "SERVICE/up", "SERVICE/changed", "SERVICE/version_changed", "SERVICE/error"] }
      ]
    }
  ],
  "power": {
    "enabled": true,
    "testURL": "http://www.msftconnecttest.com/connecttest.txt",
    "expect": "Microsoft Connect Test",
    "maxWaitSeconds": 180,
    "settleSeconds": 0,
    "checkSeconds": 5
  },
  "baseline": {
    "enabled": false,
    "path": "%ProgramData%\\exmon\\baseline.jsonl",
    "summaryMinutes": 15,
    "maxSizeMB": 100,
    "maxFiles": 5
  }
}
